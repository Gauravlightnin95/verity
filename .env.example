# --- Cloud API keys ---
# Only GROQ_API_KEY is really needed - web search falls back to keyless
# DuckDuckGo, so Tavily/GNews/FactCheck are optional bonus providers.
# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
TAVILY_API_KEY=
GNEWS_API_KEY=
GOOGLE_FACTCHECK_API_KEY=

# --- Swytchcode execution kernel ---
# The Google Fact Check provider runs through the Swytchcode CLI kernel, which
# owns schema validation, request assembly and typed error classification.
# Setup (once): npm i -g swytchcode && swytchcode login
#               swytchcode get factchecktools
#               swytchcode add factchecktools.v1alpha1.claimssearch.list
# The token below is only needed for registry commands (`get`/`search`) - the
# `exec` path used at verify time reads the committed .swytchcode/ bundles and
# works offline, so leaving this empty degrades nothing.
SWYTCHCODE_TOKEN=
# true = report the request each kernel call would make, without issuing it.
# Handy for demoing the execution-policy layer without spending API quota.
SWYTCHCODE_DRY_RUN=false

# --- Judge/claim/stance LLM (free tier: https://console.groq.com) ---
# Groq decommissioned every Llama chat model (llama-3.3-70b-versatile now
# 404s with "model does not exist"). Verify what your key can actually reach:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Free tier caps the large model at ~100k tokens/DAY (~30-40 verifies).
# For heavy testing days switch to the smaller model (much higher daily
# budget, slightly lower judging quality): LLM_MODEL=openai/gpt-oss-20b
# Note: qwen/qwen3.6-27b does NOT work - it fails the function-calling that
# with_structured_output() depends on.
LLM_MODEL=openai/gpt-oss-120b

# --- Streamlit UI -> FastAPI backend ---
BACKEND_BASE_URL=http://localhost:8000
BACKEND_TIMEOUT_SECONDS=120

# --- AI-text detector (statistics-only unless you `uv sync --extra local-ai-text`) ---
DETECTOR_LOCAL=false
DETECTOR_MODEL_NAME=roberta-base-openai-detector
DETECTOR_MIN_WORDS=150

# --- Streamlit server ---
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE_PATH=logs/verity.log
